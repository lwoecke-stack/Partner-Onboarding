# Siemens Partner Onboarding — Environment Configuration
# Copy this file to .env and fill in your values.

# Application
APP_NAME=Siemens Partner Onboarding System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# API server
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///database/PartnerOnboarding.db

# JWT Authentication
SECRET_KEY=change-me-to-a-long-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Azure OpenAI (optional — system runs in fallback mode without these)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Paths
BACKUP_DIR=backups
REPORTS_DIR=reports
EXPORTS_DIR=exports
LOGS_DIR=logs

# Settings
MAX_BACKUPS=20
SEED_RECORDS=500
